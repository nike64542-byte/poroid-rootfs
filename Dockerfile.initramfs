# ─────────────────────────────────────────────────────────────────────────────
# Podroid VM Initramfs (Debian) Build
#
# Produces initrd.img: a Debian arm64 boot stage that mounts the persistent
# overlay + the read-only squashfs, then switch_roots into the real guest OS
# (/sbin/init inside kali/debian/ubuntu-rootfs.squashfs).
#
# Debian-based boot stage on the same ecosystem as the guest rootfs images.
# Only the tools init-podroid actually invokes are installed (mount/switch_root/
# e2fsprogs/kmod/coreutils); podman/ttyd/etc. belong to the guest rootfs, not
# this boot stage.
#
# No kernel modules are needed: the custom Podroid kernel forces every driver
# the VM needs (=y), so /lib/modules stays empty.
# ─────────────────────────────────────────────────────────────────────────────

# Stage 1: Build the minimal Debian boot rootfs (arm64)
FROM --platform=linux/arm64 debian:bookworm-slim AS rootfs-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    coreutils \
    util-linux \
    e2fsprogs \
    kmod \
    ca-certificates \
    procps \
 && rm -rf /var/lib/apt/lists/*

# Strip man/docs/locale to shrink the initramfs
RUN rm -rf /usr/share/man /usr/share/doc /usr/share/locale /usr/share/info /usr/lib/debug

COPY init-podroid /init
RUN chmod +x /init

# Custom kernel ships no modules; provide the empty dir the init checks for.
RUN mkdir -p /lib/modules

# Stage 2: Pack Initramfs (host-agnostic: runs under qemu-arm64)
FROM --platform=linux/arm64 debian:bookworm-slim AS packer
RUN apt-get update && apt-get install -y --no-install-recommends \
    cpio \
    gzip \
    findutils \
 && rm -rf /var/lib/apt/lists/*

COPY --from=rootfs-builder / /rootfs/
# Strip ephemeral dirs and boot dir
RUN rm -rf /rootfs/proc/* /rootfs/sys/* /rootfs/dev/* /rootfs/run/* \
           /rootfs/tmp/* /rootfs/boot
RUN mkdir -p /output \
 && cd /rootfs && find . | cpio -o -H newc 2>/dev/null | gzip -9 > /output/initrd.img

FROM scratch AS export
COPY --from=packer /output/initrd.img /initrd.img
