#!/bin/sh
# Terminal resize daemon. Reads "RESIZE rows cols" lines from a ctrl
# virtio-console (/dev/hvcN) and applies them to a target terminal
# (/dev/hvcM) via stty. The Android side's libpodroid-bridge debounces
# SIGWINCH bursts and emits one line per stable size.
#
# Args: <ctrl-hvc> <target-hvc>   e.g. "hvc1 hvc0" (primary tab 0),
#                                   "hvc4 hvc3" (extra tab 1).
#
# Also writes the last-known size to /run/term_size_<ctrl> so podroid-login
# can restore it after each getty respawn (virtio-console resets winsize
# to 0x0 every time the line is reopened). The primary's podroid-login
# reads the legacy /run/term_size for backward compatibility; extra
# terminals use the per-port file.
#
# No `set -e`: this is a long-lived `while read` daemon. A transient stty
# failure (e.g. /dev/hvcM momentarily unavailable during a getty respawn)
# or a tmpfs write hiccup must not terminate the daemon for the rest of
# the VM's life; start-stop-daemon --background won't respawn it.

CTRL="$1"
TARGET="$2"
STATE="/run/term_size_${CTRL}"

# Wait for the ctrl virtio-console node to appear (timing varies).
for _i in $(seq 1 30); do
    [ -c "/dev/$CTRL" ] && break
    sleep 1
done
[ -c "/dev/$CTRL" ] || exit 0

while IFS= read -r _line; do
    case "$_line" in
        RESIZE\ *)
            set -- $_line
            # Reject empty / non-numeric / zero rows or cols before persisting:
            # a malformed line must not stamp junk into the state file (which
            # podroid-login reads back) or stty a 0x0 winsize onto the target.
            case "$2" in ''|*[!0-9]*|0) continue;; esac
            case "$3" in ''|*[!0-9]*|0) continue;; esac
            stty rows "$2" cols "$3" </dev/$TARGET 2>/dev/null
            printf '%s %s\n' "$2" "$3" > "$STATE" 2>/dev/null
            ;;
    esac
done </dev/$CTRL