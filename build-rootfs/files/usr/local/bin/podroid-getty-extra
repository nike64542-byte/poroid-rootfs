#!/bin/sh
# Extra-terminal getty wrapper for multi-window support (terminal tabs > 0).
#
# The primary console (hvc0) uses podroid-getty, which keys off the kernel
# cmdline marker podroid.tty=. Extra virtio-console ports (hvc3, hvc5, ...)
# exist only on the QEMU backend — AVF/crosvm does not expose them — so this
# wrapper must NOT be hard-wired to a backend. It waits for the device node,
# and if it never appears (AVF, or a QEMU config without that port) it parks
# with a long sleep instead of exiting, so sysvinit does not throttle the
# respawn ("respawning too fast") and the boot banner stays clean.
TTY="$1"

# Bounded wait for the virtio-console node (timing varies per backend).
for _i in $(seq 1 30); do
    [ -c "/dev/$TTY" ] && break
    sleep 1
done
[ -c "/dev/$TTY" ] || exec sleep 2147483647

# Clear the screen + scrollback so the new login banner sits on a clean
# buffer (mirrors what podroid-getty does for the primary terminal).
printf '\033[3J\033[2J\033[H' > "/dev/$TTY" 2>/dev/null
exec /sbin/getty -L -a root -l /usr/local/bin/podroid-login 115200 "$TTY" xterm-256color